---
const updatedAt = new Date();
const formatted = updatedAt.toLocaleString('en-GB', {
	day: 'numeric',
	month: 'short',
	year: 'numeric',
	hour: '2-digit',
	minute: '2-digit',
});
---

<p class="no-print absolute top-3 right-3 text-[0.7rem] text-cv-accent tracking-wide m-0">
	Updated {formatted}
</p>
